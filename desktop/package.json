{
  "name": "opencharts-desktop",
  "productName": "OpenCharts",
  "version": "0.6.4",
  "description": "Windows desktop trading-chart app: live crypto from Binance, OKX, Bybit, KuCoin, Coinbase and MEXC, DEX pools on every chain, forex and spot gold, with real trading through exchange API keys, a portfolio and market overview dashboard, 80+ TradingView-style drawing tools, indicators and paper trading (OpenCharts in Electron).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node dev/tools/build-web.mjs",
    "start": "electron .",
    "test": "node --test \"dev/tests/*.test.mjs\" \"dev/tests/*.test.ts\"",
    "smoke": "node dev/tools/smoke.mjs",
    "dist": "node dev/tools/build-web.mjs && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.thrivelab.opencharts",
    "productName": "OpenCharts",
    "directories": { "output": "dist" },
    "files": ["electron/**", "web/**", "package.json", "LICENSE", "NOTICE"],
    "win": {
      "target": "portable",
      "icon": "web/icons/icon-512x512.png"
    },
    "portable": { "artifactName": "OpenCharts-${version}-portable.exe" }
  }
}
